# Variables de entorno del FRONTEND (React + Vite)
# Copia este archivo a `.env` y completa los valores reales.
# ⚠ NUNCA comitear `.env` (ya está en .gitignore). Usa valores reales solo localmente.

# URL base de la API backend (producción)
# VITE_BACKEND_URL=https://crmsumichen.com/api
VITE_BACKEND_URL=http://localhost:3000

# Proyecto Supabase (auth + storage)
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=TU_ANON_KEY_PUBLICA

# Clave pública VAPID para Web Push (PWA). Debe coincidir con VAPID_PUBLIC_KEY
# del backend. Genera el par con: node backend/scripts/generarVapid.js
VITE_VAPID_PUBLIC_KEY=TU_VAPID_PUBLIC_KEY