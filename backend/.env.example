# Variables de entorno del BACKEND (Express + TypeORM)
# Copia este archivo a `.env` y completa los valores reales.
# ⚠ NUNCA comitear `.env` (ya está en .gitignore). Este archivo de ejemplo NO debe tener valores reales.

# Base de datos PostgreSQL (TypeORM)
DATABASE_URL=postgres://usuario:password@host:5432/nombre_db

# Aplica migraciones automáticamente al arrancar. Ponlo en false para desactivar
# (útil en emergencias o si prefieres ejecutar las migraciones manualmente).
RUN_MIGRATIONS=true

# Supabase (auth + storage)
SUPABASE_URL=https://TU-PROYECTO.supabase.co
# El backend usa una de estas claves según el contexto:
SUPABASE_KEY=TU_SERVICE_ROLE_KEY
SUPABASE_SERVICE_ROLE_KEY=TU_SERVICE_ROLE_KEY
SUPABASE_ANON_KEY=TU_ANON_KEY_PUBLICA
# Secreto para verificar JWTs de Supabase (HS256)
SUPABASE_JWT_SECRET=TU_JWT_SECRET

# Twilio (WhatsApp)
TWILIO_ACCOUNT_SID=TU_ACCOUNT_SID
TWILIO_AUTH_TOKEN=TU_AUTH_TOKEN
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
ADMIN_WHATSAPP_NUMBER=whatsapp:+58XXXXXXXXXX

# Meta WhatsApp Cloud API
META_PHONE_ID=TU_PHONE_ID
META_TOKEN=TU_TOKEN_DE_ACCESO
META_RECIPIENT=+58XXXXXXXXXX
# Webhook entrante (Fase 2): token de verificación que configuras en Meta
# Developer App → WhatsApp → Configuration → Webhook. Debe coincidir con el
# verify_token que Meta envía en el GET de verificación.
META_VERIFY_TOKEN=TU_TOKEN_DE_VERIFICACION_WEBHOOK
# App Secret de la Meta App: se usa para validar la firma X-Hub-Signature-256
# de los webhooks entrantes (mensajes de WhatsApp). Sin esto el middleware
# omite la validación (solo apto para pruebas locales).
META_APP_SECRET=TU_APP_SECRET_DE_META

# Pushover (notificaciones push de nuevos pedidos)
PUSHOVER_USER=TU_USER_KEY
PUSHOVER_TOKEN=TU_APP_TOKEN

# URL pública de la app (se usa para construir la evidencia_url de pedidos y el link de Pushover)
# Prod (default): https://crmsumichen.com/api — Dev: http://localhost:3000 (igual que VITE_BACKEND_URL del frontend, SIN /api)
PUBLIC_API_URL=https://crmsumichen.com/api
# URL base que abre la notificación push (default: https://crmsumichen.com)
APP_PUBLIC_URL=https://crmsumichen.com
# Carpeta donde se guardan las evidencias de pedidos.
# Prod default: /var/www/crm-backend/uploads/evidencias (se resuelve automáticamente).
# Dev local: apuntar a la carpeta local del backend, ej. E:/ruta/a/backend/uploads/evidencias
EVIDENCIA_UPLOAD_PATH=

# Worker de limpieza de evidencias (proceso separado: node build/worker/clean.js)
RUN_CRON=false
CLEANUP_CRON=0 3 * * *
CLEANUP_DAYS=60
CLEANUP_TZ=UTC
SUPABASE_CLEANUP_BUCKET=evidencias

# Web Push (PWA - notificaciones en el dispositivo)
# Genera el par con: node backend/scripts/generarVapid.js
VAPID_PUBLIC_KEY=TU_VAPID_PUBLIC_KEY
VAPID_PRIVATE_KEY=TU_VAPID_PRIVATE_KEY
VAPID_SUBJECT=mailto:admin@crmsumichen.com

# WebAuthn (acceso biométrico / huella)
# RP_ID = dominio efectivo (prod: crmsumichen.com | dev: localhost)
# RP_ORIGIN = origen del FRONTEND (prod: https://crmsumichen.com | dev: http://localhost:5173)
RP_ID=TU_DOMINIO
RP_ORIGIN=TU_ORIGEN_FRONTEND
RP_NAME=Sumichem CRM